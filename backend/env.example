# --------------------------
# MongoDB (Optional)
# For MongoDB Atlas, format:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# Leave empty if you do not want DB.
MONGO_URI=

# --------------------------
# Redis (Optional)
# For Railway Redis:
# REDIS_URL=redis://default:<password>@<host>:<port>
REDIS_URL=

# --------------------------
# News API (Optional)
# You are NOT using external news providers now.
# Leave empty.
NEWSAPI_KEY=

# --------------------------
# OpenAI Key (Optional)
# Only needed if you want AI-driven health advisory.
# Otherwise system will use fallback reasoning.
OPENAI_API_KEY=

# --------------------------
# Nothing else required
